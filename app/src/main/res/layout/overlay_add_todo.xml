<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/overlay_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/overlay_card_bg"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quick_add_todo"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/overlay_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/overlay_input_bg"
            android:hint="@string/todo_hint"
            android:padding="12dp"
            android:textColor="#000000"
            android:textColorHint="#8E8E93"
            android:maxLines="3"
            android:inputType="textCapSentences|textMultiLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/overlay_cancel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/circle_gray_button"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/cancel" />

            <ImageButton
                android:id="@+id/overlay_save"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_black_button"
                android:padding="12dp"
                android:src="@drawable/ic_check_mark_white"
                android:contentDescription="@string/save" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
